{
  "info": {
    "name": "Evaluación 03 - Laboratorio 17 - Soporte técnico",
    "description": "Ejecutar en orden con MySQL y los tres servicios activos. Los IDs se capturan automáticamente. La carpeta 04 elimina solo los registros creados por esta ejecución. No contiene contraseñas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "usuarioBaseUrl", "value": "http://localhost:8081"},
    {"key": "tecnicoBaseUrl", "value": "http://localhost:8082"},
    {"key": "ticketBaseUrl", "value": "http://localhost:8083"},
    {"key": "missingId", "value": "9000000000000000000"}
  ],
  "event": [
    {"listen": "prerequest", "script": {"type": "text/javascript", "exec": [
      "if (pm.request.body && pm.request.body.mode === 'raw') pm.request.headers.upsert({key: 'Content-Type', value: 'application/json'});"
    ]}},
    {"listen": "test", "script": {"type": "text/javascript", "exec": [
      "const esperado = Number(pm.info.requestName.substring(0, 3));",
      "pm.test('Código HTTP ' + esperado, function () { pm.response.to.have.status(esperado); });",
      "if (pm.response.code === 201) {",
      "  const data = pm.response.json();",
      "  pm.test('ID generado y Location', function () { pm.expect(data.id).to.be.above(0); pm.response.to.have.header('Location'); });",
      "  const ruta = pm.request.url.toString();",
      "  if (ruta.includes('/api/usuarios')) pm.collectionVariables.set('usuarioId', String(data.id));",
      "  if (ruta.includes('/api/tecnicos')) pm.collectionVariables.set('tecnicoId', String(data.id));",
      "  if (ruta.includes('/api/tickets')) pm.collectionVariables.set('ticketId', String(data.id));",
      "}",
      "if (esperado >= 400 && pm.response.code === esperado) {",
      "  const error = pm.response.json();",
      "  pm.test('Error JSON comprensible', function () { pm.expect(error.codigo).to.eql(esperado); pm.expect(error.mensaje).to.be.a('string').and.not.empty; pm.expect(error).to.have.property('errores'); pm.expect(error).to.have.property('ruta'); });",
      "}",
      "if (pm.request.method === 'PATCH' && pm.response.code === 200) {",
      "  const enviado = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
      "  pm.test('Estado actualizado', function () { pm.expect(pm.response.json().estado).to.eql(enviado.estado); });",
      "}",
      "if (esperado === 204) pm.test('Sin cuerpo después de eliminar', function () { pm.expect(pm.response.text()).to.eql(''); });"
    ]}}
  ],
  "item": [
    {
      "name": "01 - Usuarios",
      "item": [
        {
          "name": "201 - Crear usuario",
          "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": [
            "pm.collectionVariables.set('runKey', Date.now().toString() + Math.floor(Math.random() * 10000));",
            "['usuarioId', 'tecnicoId', 'ticketId'].forEach(function (key) { pm.collectionVariables.unset(key); });"
          ]}}],
          "request": {"method": "POST", "url": "{{usuarioBaseUrl}}/api/usuarios", "body": {"mode": "raw", "raw": "{\"nombres\":\"Leonel\",\"apellidos\":\"Retamozo\",\"correo\":\"leonel.{{runKey}}@example.test\"}"}}
        },
        {"name": "200 - Listar usuarios", "request": {"method": "GET", "url": "{{usuarioBaseUrl}}/api/usuarios"}},
        {"name": "200 - Buscar usuario por ID", "request": {"method": "GET", "url": "{{usuarioBaseUrl}}/api/usuarios/{{usuarioId}}"}},
        {"name": "200 - Actualizar usuario", "request": {"method": "PUT", "url": "{{usuarioBaseUrl}}/api/usuarios/{{usuarioId}}", "body": {"mode": "raw", "raw": "{\"nombres\":\"Leonel Mathias\",\"apellidos\":\"Retamozo De La Cruz\",\"correo\":\"leonel.{{runKey}}@example.test\"}"}}},
        {"name": "400 - Usuario con datos inválidos", "request": {"method": "POST", "url": "{{usuarioBaseUrl}}/api/usuarios", "body": {"mode": "raw", "raw": "{\"nombres\":\" \",\"apellidos\":\"\",\"correo\":\"correo-invalido\"}"}}},
        {"name": "409 - Correo de usuario duplicado", "request": {"method": "POST", "url": "{{usuarioBaseUrl}}/api/usuarios", "body": {"mode": "raw", "raw": "{\"nombres\":\"Otro\",\"apellidos\":\"Usuario\",\"correo\":\"leonel.{{runKey}}@example.test\"}"}}},
        {"name": "404 - Usuario inexistente", "request": {"method": "GET", "url": "{{usuarioBaseUrl}}/api/usuarios/{{missingId}}"}},
        {"name": "400 - ID de usuario negativo", "request": {"method": "GET", "url": "{{usuarioBaseUrl}}/api/usuarios/-1"}}
      ]
    },
    {
      "name": "02 - Técnicos",
      "item": [
        {"name": "201 - Crear técnico", "request": {"method": "POST", "url": "{{tecnicoBaseUrl}}/api/tecnicos", "body": {"mode": "raw", "raw": "{\"nombres\":\"Ana\",\"apellidos\":\"Torres\",\"correo\":\"ana.{{runKey}}@example.test\",\"especialidad\":\"Soporte de equipos\"}"}}},
        {"name": "200 - Listar técnicos", "request": {"method": "GET", "url": "{{tecnicoBaseUrl}}/api/tecnicos"}},
        {"name": "200 - Buscar técnico por ID", "request": {"method": "GET", "url": "{{tecnicoBaseUrl}}/api/tecnicos/{{tecnicoId}}"}},
        {"name": "200 - Actualizar técnico", "request": {"method": "PUT", "url": "{{tecnicoBaseUrl}}/api/tecnicos/{{tecnicoId}}", "body": {"mode": "raw", "raw": "{\"nombres\":\"Ana\",\"apellidos\":\"Torres\",\"correo\":\"ana.{{runKey}}@example.test\",\"especialidad\":\"Redes\"}"}}},
        {"name": "400 - Técnico sin especialidad", "request": {"method": "POST", "url": "{{tecnicoBaseUrl}}/api/tecnicos", "body": {"mode": "raw", "raw": "{\"nombres\":\"Ana\",\"apellidos\":\"Torres\",\"correo\":\"otro@example.test\",\"especialidad\":\"\"}"}}},
        {"name": "409 - Correo de técnico duplicado", "request": {"method": "POST", "url": "{{tecnicoBaseUrl}}/api/tecnicos", "body": {"mode": "raw", "raw": "{\"nombres\":\"Otro\",\"apellidos\":\"Técnico\",\"correo\":\"ana.{{runKey}}@example.test\",\"especialidad\":\"Redes\"}"}}},
        {"name": "404 - Técnico inexistente", "request": {"method": "GET", "url": "{{tecnicoBaseUrl}}/api/tecnicos/{{missingId}}"}}
      ]
    },
    {
      "name": "03 - Tickets y estados",
      "item": [
        {"name": "201 - Crear ticket ABIERTO", "request": {"method": "POST", "url": "{{ticketBaseUrl}}/api/tickets", "body": {"mode": "raw", "raw": "{\"idUsuario\":{{usuarioId}},\"idTecnico\":{{tecnicoId}},\"asunto\":\"Sin conexión\",\"descripcion\":\"La computadora no accede a Internet\",\"prioridad\":\"MEDIA\",\"estado\":\"ABIERTO\"}"}}},
        {"name": "200 - Listar tickets", "request": {"method": "GET", "url": "{{ticketBaseUrl}}/api/tickets"}},
        {"name": "200 - Buscar ticket por ID", "request": {"method": "GET", "url": "{{ticketBaseUrl}}/api/tickets/{{ticketId}}"}},
        {"name": "200 - Actualizar ticket completo", "request": {"method": "PUT", "url": "{{ticketBaseUrl}}/api/tickets/{{ticketId}}", "body": {"mode": "raw", "raw": "{\"idUsuario\":{{usuarioId}},\"idTecnico\":{{tecnicoId}},\"asunto\":\"Sin conexión de red\",\"descripcion\":\"Se revisará el adaptador de red\",\"prioridad\":\"ALTA\",\"estado\":\"ABIERTO\"}"}}},
        {"name": "200 - Cambiar estado a EN_PROCESO", "request": {"method": "PATCH", "url": "{{ticketBaseUrl}}/api/tickets/{{ticketId}}/estado", "body": {"mode": "raw", "raw": "{\"estado\":\"EN_PROCESO\"}"}}},
        {"name": "200 - Cambiar estado a CERRADO", "request": {"method": "PATCH", "url": "{{ticketBaseUrl}}/api/tickets/{{ticketId}}/estado", "body": {"mode": "raw", "raw": "{\"estado\":\"CERRADO\"}"}}},
        {
          "name": "200 - Comprobar que CERRADO quedó guardado",
          "request": {"method": "GET", "url": "{{ticketBaseUrl}}/api/tickets/{{ticketId}}"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Estado persistido', function () { pm.expect(pm.response.json().estado).to.eql('CERRADO'); });"
          ]}}]
        },
        {"name": "400 - Ticket con datos inválidos", "request": {"method": "POST", "url": "{{ticketBaseUrl}}/api/tickets", "body": {"mode": "raw", "raw": "{\"idUsuario\":0,\"idTecnico\":-1,\"asunto\":\" \",\"descripcion\":\"\"}"}}},
        {"name": "400 - Prioridad no permitida", "request": {"method": "POST", "url": "{{ticketBaseUrl}}/api/tickets", "body": {"mode": "raw", "raw": "{\"idUsuario\":{{usuarioId}},\"idTecnico\":{{tecnicoId}},\"asunto\":\"Prueba\",\"descripcion\":\"Detalle\",\"prioridad\":\"URGENTE\",\"estado\":\"ABIERTO\"}"}}},
        {"name": "400 - Prioridad numérica rechazada", "request": {"method": "POST", "url": "{{ticketBaseUrl}}/api/tickets", "body": {"mode": "raw", "raw": "{\"idUsuario\":{{usuarioId}},\"idTecnico\":{{tecnicoId}},\"asunto\":\"Prueba\",\"descripcion\":\"Detalle\",\"prioridad\":1,\"estado\":\"ABIERTO\"}"}}},
        {"name": "400 - Estado no permitido", "request": {"method": "PATCH", "url": "{{ticketBaseUrl}}/api/tickets/{{ticketId}}/estado", "body": {"mode": "raw", "raw": "{\"estado\":\"RESUELTO\"}"}}},
        {"name": "400 - Estado obligatorio", "request": {"method": "PATCH", "url": "{{ticketBaseUrl}}/api/tickets/{{ticketId}}/estado", "body": {"mode": "raw", "raw": "{}"}}},
        {"name": "400 - JSON malformado", "request": {"method": "POST", "url": "{{ticketBaseUrl}}/api/tickets", "body": {"mode": "raw", "raw": "{"}}},
        {"name": "404 - Ticket inexistente", "request": {"method": "GET", "url": "{{ticketBaseUrl}}/api/tickets/{{missingId}}"}},
        {"name": "404 - Cambiar estado de ticket inexistente", "request": {"method": "PATCH", "url": "{{ticketBaseUrl}}/api/tickets/{{missingId}}/estado", "body": {"mode": "raw", "raw": "{\"estado\":\"CERRADO\"}"}}},
        {"name": "404 - Actualizar ticket inexistente", "request": {"method": "PUT", "url": "{{ticketBaseUrl}}/api/tickets/{{missingId}}", "body": {"mode": "raw", "raw": "{\"idUsuario\":{{usuarioId}},\"idTecnico\":{{tecnicoId}},\"asunto\":\"Prueba\",\"descripcion\":\"Detalle\",\"prioridad\":\"BAJA\",\"estado\":\"ABIERTO\"}"}}}
      ]
    },
    {
      "name": "04 - Limpieza",
      "description": "Ejecutar al terminar las capturas. Solo elimina los IDs creados por esta ejecución.",
      "item": [
        {"name": "204 - Eliminar ticket", "request": {"method": "DELETE", "url": "{{ticketBaseUrl}}/api/tickets/{{ticketId}}"}},
        {"name": "404 - Confirmar eliminación del ticket", "request": {"method": "GET", "url": "{{ticketBaseUrl}}/api/tickets/{{ticketId}}"}},
        {"name": "204 - Eliminar técnico", "request": {"method": "DELETE", "url": "{{tecnicoBaseUrl}}/api/tecnicos/{{tecnicoId}}"}},
        {"name": "404 - Confirmar eliminación del técnico", "request": {"method": "GET", "url": "{{tecnicoBaseUrl}}/api/tecnicos/{{tecnicoId}}"}},
        {"name": "204 - Eliminar usuario", "request": {"method": "DELETE", "url": "{{usuarioBaseUrl}}/api/usuarios/{{usuarioId}}"}},
        {"name": "404 - Confirmar eliminación del usuario", "request": {"method": "GET", "url": "{{usuarioBaseUrl}}/api/usuarios/{{usuarioId}}"}}
      ]
    }
  ]
}
